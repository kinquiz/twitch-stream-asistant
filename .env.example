# Имя аккаунта бота (в нижнем регистре), которым он заходит в чат
TWITCH_BOT_USERNAME=my_stream_bot

# OAuth-токен бота для подключения к чату (tmi.js).
# Получить: https://twitchapps.com/tmi/ (формат "oauth:xxxxxxxx"), либо через
# собственный OAuth-флоу с нужными scope: chat:read chat:edit.
# Для подписки на EventSub-редемпшены этому же токену дополнительно нужен
# scope channel:read:redemptions, и он должен принадлежать бродкастеру
# (или модератору, авторизованному на чтение редемпшенов канала).
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Канал, к которому подключается бот (без #, в нижнем регистре)
TWITCH_CHANNEL=my_channel

# Client ID и Client Secret приложения из Twitch Developer Console
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret

# ID награды Channel Points "Заказать музыку"
REWARD_ID_MUSIC=00000000-0000-0000-0000-000000000000
